{
  "name": "@insomniac-vibelabs/two-key-toolcheck",
  "version": "0.9.1",
  "description": "Two-Key's tool check for MCP servers in TypeScript: verify the token and redeem stamp, refuse replays, sign the receipt",
  "license": "Apache-2.0",
  "author": "Stephan Busch",
  "homepage": "https://github.com/Insomniac-VibeLabs/two-key/blob/main/docs/TOOL_CHECK.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Insomniac-VibeLabs/two-key.git",
    "directory": "typescript/toolcheck"
  },
  "bugs": "https://github.com/Insomniac-VibeLabs/two-key/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "two-key",
    "ai-agent",
    "authorization",
    "ml-dsa"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "npm run build:test && node --enable-source-maps --test \"build/test/*.test.js\"",
    "prepack": "npm run build",
    "coverage": "npm run build:test && node --enable-source-maps --experimental-test-coverage --test-coverage-include=\"**/src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --test \"build/test/*.test.js\""
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
