  SP --> RU["Structured rules"]
  SP --> PR["Prose"]
  RU --> C["compile_constitution<br/>stack bytecode"]
  C --> SC{"verify_structured_only<br/>LOAD structured fields only,<br/>no string ops, ends in PASS"}
  SC -- fail --> R2["refused at load"]
  SC -- ok --> BC["Path A bytecode"]
  PR --> JP["Path B judge prompt text"]
  BC --> HB["bytecode_hash = H(canonical bytecode)"]
  JP --> HN["nl_hash = H(prose)"]
  HB --> LE["ledger: constitution_loaded<br/>{constitution_digest, bytecode_hash, nl_hash, ...}"]
  HN --> LE
  HB --> BT["bound into every ballot<br/>and every capability token"]
  HN --> BT
  LE --> GW["gateway compares token hashes<br/>with the latest constitution_loaded entry"]
